{
  "openapi": "3.1.0",
  "info": {
    "title": "Istem Medikal API",
    "version": "1.0.0",
    "description": "Istem Medikal A.Ş. — Ortak API şema tanımları",
    "contact": {
      "name": "Istem Medikal ArGe",
      "email": "istemmedikalai@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Geliştirme ortamı"
    },
    {
      "url": "https://api.istemmedikal.com",
      "description": "Üretim ortamı"
    }
  ],
  "components": {
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "UUID v4 formatında benzersiz kimlik",
        "examples": [
          "123e4567-e89b-12d3-a456-426614174000"
        ]
      },
      "PaginationQuery": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Sayfa numarası"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Sayfa başına kayıt sayısı"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Hata kodu",
            "examples": [
              "VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "description": "Hata mesajı"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Alan bazlı hata detayları"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Ürün ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Ürün adı",
            "examples": [
              "LUBRAGEL"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "catheter",
              "gel",
              "instillation",
              "implant",
              "irrigation"
            ],
            "description": "Ürün kategorisi"
          },
          "catalogCode": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$",
            "description": "Katalog kodu",
            "examples": [
              "LUB-006"
            ]
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "description": "Ürün aktif mi?"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Oluşturulma tarihi"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "catalogCode",
          "createdAt"
        ]
      },
      "CreateProduct": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Ürün adı",
            "examples": [
              "LUBRAGEL"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "catheter",
              "gel",
              "instillation",
              "implant",
              "irrigation"
            ],
            "description": "Ürün kategorisi"
          },
          "catalogCode": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$",
            "description": "Katalog kodu",
            "examples": [
              "LUB-006"
            ]
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "description": "Ürün aktif mi?"
          }
        },
        "required": [
          "name",
          "category",
          "catalogCode"
        ]
      },
      "UpdateProduct": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Ürün adı",
            "examples": [
              "LUBRAGEL"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "catheter",
              "gel",
              "instillation",
              "implant",
              "irrigation"
            ],
            "description": "Ürün kategorisi"
          },
          "catalogCode": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$",
            "description": "Katalog kodu",
            "examples": [
              "LUB-006"
            ]
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "description": "Ürün aktif mi?"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {},
  "webhooks": {}
}