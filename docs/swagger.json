  "components": {
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "UUID v4 formatında benzersiz kimlik",
        "examples": [
          "123e4567-e89b-12d3-a456-426614174000"
        ]
      },
      "PaginationQuery": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Sayfa numarası"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Sayfa başına kayıt sayısı"
          }
        }
      },
      "ApiSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "Başarı mesajı"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "success"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "Hata mesajı"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "loginUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "addUser": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Barış"
            ]
          },
          "surname": {
            "type": "string",
            "examples": [
              "Gür"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "examples": [
              "ua_baris_07@hotmail.com"
            ]
          },
          "phoneNumber": {
            "type": "string",
            "examples": [
              "905365056943"
            ]
          },
          "password": {
            "type": "string",
            "examples": [
              "Passw0rd"
            ]
          }
        },
        "required": [
          "name",
          "email",
          "phoneNumber",
          "password"
        ]
      },
      "checkKey": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ]
      },
      "activateUser": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "code"
        ]
      },
      "passwordResetUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "passwordResetCompleteUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "key": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "key",
          "newPassword"
        ]
      }
    },
    "parameters": {}
  },
